# Copy to .env.local and adjust for your machine.

# Frontend-only mode. true = sign in against src/lib/mockAuth.js demo accounts,
# false = call the real backend /login endpoint.
NEXT_PUBLIC_MOCK_AUTH=true

# "local" = app owns its /Login page. "portal" = handed off from an external portal.
NEXT_PUBLIC_LOGIN_MODE=local

# --- Only needed once the AMS backend exists ---
# Backend the /ams/api rewrite would proxy to (re-enable rewrites in next.config.mjs).
# BACKEND_URL=http://localhost:9098

# API base URL used by the browser. Leave unset to use the proxied relative path.
# NEXT_PUBLIC_API_BASE_URL=/ams/api

# Next basePath. Must match `basePath` in next.config.mjs.
# NEXT_PUBLIC_BASE_PATH=/ams
